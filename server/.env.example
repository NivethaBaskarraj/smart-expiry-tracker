# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/smart-expiry-tracker
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smart-expiry-tracker
MONGO_URI=mongodb://127.0.0.1:27017/smart-expiry-tracker

# Secret used to sign JWT tokens - use any long random string
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the server runs on
PORT=5000

# Spoonacular API key - get a free key at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Email (Gmail example) - used to send "expiring soon" and "expired" alerts
# For Gmail: turn on 2FA then create an "App Password" - https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Comma separated allowed origin for CORS (your React app URL)
CLIENT_URL=http://localhost:3000
