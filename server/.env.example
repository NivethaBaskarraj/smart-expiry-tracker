# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/smart-expiry-tracker
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smart-expiry-tracker
MONGO_URI=mongodb://127.0.0.1:27017/smart-expiry-tracker

# Secret used to sign JWT tokens - use any long random string (at least 16 chars)
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the server runs on
PORT=5000

# Client origin(s) for CORS (comma-separated if multiple, e.g. production Vercel URL and localhost)
CLIENT_URL=http://localhost:3000

# Spoonacular API key - get a free key at https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Secret token for external cron pingers (e.g. cron-job.org) to trigger /api/cron/check-expiry
CRON_SECRET=replace_with_a_random_cron_secret

# ==============================================================================
# EMAIL CONFIGURATION (Provider-Swappable: brevo | resend | smtp)
# ==============================================================================
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=Smart Expiry Tracker

# Option A: Brevo HTTP API (Recommended on Render free tier - bypasses SMTP blocking)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Option B: Resend HTTP API (Alternative HTTP provider)
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_SENDER_EMAIL=onboarding@resend.dev

# Option C: Gmail / Standard SMTP (May be blocked or timeout on Render free tier)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
